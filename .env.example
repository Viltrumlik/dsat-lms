# ═══════════════════════════════════════
# DSAT LMS v2 — Environment Variables
# ═══════════════════════════════════════
# Nusxa: cp .env.example .env
# .env ni hech qachon git'ga commit qilmang!

# ─────────────────────────────────────
# Django Core
# ─────────────────────────────────────
DJANGO_SECRET_KEY=change-this-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# ─────────────────────────────────────
# Database
# ─────────────────────────────────────
DATABASE_URL=postgresql://dsat:dsat@postgres:5432/dsat_db
# Local (docker compose ichida "postgres", tashqaridan "localhost"):
# DATABASE_URL=postgresql://dsat:dsat@localhost:5432/dsat_db

# ─────────────────────────────────────
# Redis
# ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Local (tashqaridan): redis://localhost:6379/0

# ─────────────────────────────────────
# JWT
# ─────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
JWT_ROTATE_REFRESH_TOKENS=True

# ─────────────────────────────────────
# CORS
# ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────
# Storage
# ─────────────────────────────────────
STORAGE_BACKEND=local
# Production uchun: r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=dsat-lms-media
# R2_CUSTOM_DOMAIN=media.yourdomain.com

# ─────────────────────────────────────
# Email — Mailgun SMTP (dev prints to the console; these are for production)
# ─────────────────────────────────────
# EMAIL_HOST=smtp.mailgun.org            # smtp.eu.mailgun.org for an EU domain
# EMAIL_PORT=587                         # STARTTLS; 465 needs EMAIL_USE_SSL=True
# EMAIL_HOST_USER=postmaster@mg.yourdomain.com
# EMAIL_HOST_PASSWORD=                   # the DOMAIN's SMTP password, not the API key
# EMAIL_FROM=noreply@yourdomain.com

# Email limits (apps.mailer) — counted off the outbox, not per-IP, so Celery
# tasks and management commands are inside the gate too.
MAIL_COOLDOWN_SECONDS=60
MAIL_MAX_PER_RECIPIENT_PER_DAY=10        # broadcast mail
MAIL_MAX_CODES_PER_RECIPIENT_PER_DAY=5   # verification / reset codes, counted separately
MAIL_MAX_PER_DAY=2000
MAIL_RESERVE_FOR_CODES=200               # bulk stops this far short of the cap
MAIL_CODE_TTL_MINUTES=15

# ─────────────────────────────────────
# Celery
# ─────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─────────────────────────────────────
# Sentry (optional dev da)
# ─────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─────────────────────────────────────
# Frontend (Next.js)
# ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# ─────────────────────────────────────
# Auth throttling (DRF ScopedRateThrottle)
# ─────────────────────────────────────
# Per-IP rate for the auth endpoints. Format: "<count>/<s|min|hour|day>".
# Defaults below are the code defaults — tighten in production.
THROTTLE_AUTH_LOGIN=30/min
THROTTLE_AUTH_REGISTER=30/min
THROTTLE_AUTH_PASSWORD_RESET=10/min
THROTTLE_AUTH_VERIFY_EMAIL=10/min
THROTTLE_ADMIN_SET_PASSWORD=10/min
# Trusted proxy hop count for deriving the client IP. 0 = no proxy (dev): key on
# REMOTE_ADDR and ignore X-Forwarded-For. Behind Nginx set to 1 (or the real hop
# count) so the throttle keys on the true client IP, not a spoofable header.
NUM_PROXIES=0

# ─────────────────────────────────────
# Feature Flags (dev uchun)
# ─────────────────────────────────────
PUBLIC_PRACTICE_TEST_LIMIT_PER_WEEK=3
PUBLIC_PAST_PAPER_LIMIT=5

# ─────────────────────────────────────
# Production only — the compose stack reads these
# ─────────────────────────────────────
# POSTGRES_DB=dsat_db
# POSTGRES_USER=dsat
# POSTGRES_PASSWORD=                     # required; nothing else may default it
# REDIS_MAXMEMORY=256mb

# Gunicorn. WORKERS × instances must stay under Postgres max_connections —
# every worker holds its own persistent connection (CONN_MAX_AGE).
# GUNICORN_WORKERS=5
# GUNICORN_TIMEOUT=30
# GUNICORN_MAX_REQUESTS=1000

# CELERY_CONCURRENCY=4

# Sentry
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production

# Desmos (the exam calculator). Falls back to Desmos's published demo key.
# NEXT_PUBLIC_DESMOS_API_KEY=
